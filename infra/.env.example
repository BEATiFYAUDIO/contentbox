# Copy to infra/.env before using infra/docker-compose.yml.
# Generate real values locally; do not commit infra/.env.

CONTENTBOX_POSTGRES_USER=contentbox
CONTENTBOX_POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTENTBOX_POSTGRES_PORT=5432

CONTENTBOX_MINIO_ROOT_USER=replace-with-random-admin-user
CONTENTBOX_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
CONTENTBOX_MINIO_API_PORT=9000
CONTENTBOX_MINIO_CONSOLE_PORT=9001
